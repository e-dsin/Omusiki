{
  "name": "omusiki",
  "version": "1.0.0",
  "private": true,
  "description": "OMusiki monorepo: web, React Native, API, CMS, and serverless functions.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @omusiki/api",
    "dev:web": "npm run dev -w @omusiki/web",
    "dev:cms": "npm run dev -w @omusiki/cms",
    "dev:functions": "npm run dev -w @omusiki/functions",
    "dev:mobile": "npm run start -w @omusiki/mobile",
    "dev:legacy": "npm start -w @omusiki/legacy-web",
    "db:generate": "npm run generate -w @omusiki/db",
    "db:migrate": "npm run migrate -w @omusiki/db",
    "db:seed": "npm run seed -w @omusiki/db",
    "test": "node --test packages/types/src/access.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
